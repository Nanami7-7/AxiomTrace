UART4.$name                             = "UART_3";
UART4.enabledInterrupts                 = ["DMA_DONE_TX","EOT_DONE","RX"];
UART4.enabledDMATXTriggers              = "DL_UART_DMA_INTERRUPT_TX";
UART4.enableFIFO                        = true;
UART4.rxFifoThreshold                   = "DL_UART_RX_FIFO_LEVEL_ONE_ENTRY";
UART4.rxTimeoutValue                    = 10;
UART4.peripheral.$assign                = "UART3";
UART4.peripheral.rxPin.$assign          = "PB3";
UART4.peripheral.txPin.$assign          = "PA26";
UART4.txPinConfig.$name                 = "ti_driverlib_gpio_GPIOPinGeneric6";
UART4.rxPinConfig.$name                 = "ti_driverlib_gpio_GPIOPinGeneric7";
UART4.DMA_CHANNEL_TX.$name              = "DMA_CH3";
